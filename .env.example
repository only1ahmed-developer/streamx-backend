# ==========================================
# StreamX Backend - Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub.
# ==========================================

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Database ---
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/streamx?retryWrites=true&w=majority

# --- Redis (optional in Grade 1, required for caching in later grades) ---
REDIS_URL=redis://default:<password>@<host>:<port>

# --- Auth secrets (use two DIFFERENT long random strings) ---
JWT_SECRET=replace_with_a_long_random_string_for_app_users
JWT_EXPIRES_IN=30d
ADMIN_JWT_SECRET=replace_with_a_different_long_random_string_for_admin
ADMIN_JWT_EXPIRES_IN=12h

# --- External Content API (Dave Tech API) ---
PRIMARY_CONTENT_API=https://davexmovieapi.zone.id
BACKUP_CONTENT_API=

# --- Firebase (added in later grades: FCM, Analytics) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- AdMob (added in Grade 9) ---
ADMOB_APP_ID=

# --- Telegram (optional, for update notifications) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
